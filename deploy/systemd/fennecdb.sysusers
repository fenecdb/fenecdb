# /etc/sysusers.d/fennecdb.conf: a user for each role, made by
# `systemd-sysusers` (or at the next boot). A user each rather than one: a
# process reads the environment of every other process of its own user
# (/proc/<pid>/environ, which ProtectProc= hides only from other users), so
# one user for all would let rclone read the archiver's replication token,
# or a node the routers' tokens, where two roles share a machine. Users of
# their own rather than DynamicUser: the data outlive the service, and a disk
# mounted at /var/lib/fennecdb keeps one owner across reinstalls. None has a
# shell or a login.
#Type Name          ID  GECOS              Home                      Shell
u     fennec-node   -   "fennecdb node"    /var/lib/fennecdb/node    /usr/sbin/nologin
u     fennec-router -   "fennecdb router"  /var/lib/fennecdb         /usr/sbin/nologin
u     fennec-archive -  "fennecdb archive" /var/lib/fennecdb/archive /usr/sbin/nologin
u     fennec-sync   -   "fennecdb sync"    /var/lib/fennecdb         /usr/sbin/nologin
# The bucket sync reads the archives, group-readable, through the
# archiver's group (fennec-archive-sync@.service's SupplementaryGroups=).
m     fennec-sync    fennec-archive
