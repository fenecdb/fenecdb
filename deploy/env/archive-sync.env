# /etc/fennecdb/archive-sync.env -- every bucket sync on this machine
# (fennec-archive-sync@<node>.service). Holds no secret: the remote's keys are
# /etc/fennecdb/rclone.conf, handed to the run alone as a credential, and the
# archiver's replication token is not here, so rclone never sees it.

# The bucket, as rclone names it in /etc/fennecdb/rclone.conf: a remote and a
# path. Each node's archive goes under it by the node's name.
FENNEC_ARCHIVE_REMOTE=r2:fennecdb-archive/eu
