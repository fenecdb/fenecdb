# A region's router, keeping the region's own directory: its nodes, its
# tenants, their leases and failovers (deploy/RUNBOOK.md).
# Its addresses are in /etc/fennecdb/router.env, its tokens too: read by
# systemd as root, 0600, and on no command line, which `ps` shows every user.
#
#   install -m 0644 fennec-router.service /etc/systemd/system/
#   install -m 0600 ../env/router.env /etc/fennecdb/router.env   # then edit it
#   systemctl enable --now fennec-router

[Unit]
Description=fennecdb region router (fennec-shard --region)
Documentation=https://fenecdb.com/docs/sharding-reference#deploying file:/usr/local/share/doc/fennecdb/RUNBOOK.md
After=network-online.target
Wants=network-online.target
# One process on the directory file at a time: two corrupt it.
Conflicts=fennec-router-standby.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=fennec-router
Group=fennec-router
EnvironmentFile=/etc/fennecdb/router.env
# --region keeps the region's nodes and tenants in this router's directory,
# so it leases them and fails them over cut off from every other region;
# --global is where every other tenant lives (the global router, then its
# standby). --replicas gives each tenant a replica on a node of another
# zone of the region; --auto-failover leases the nodes for FENNEC_LEASE
# seconds and fails over a node that lets its lease lapse.
ExecStart=/usr/local/bin/fennec-shard \
    --listen ${FENNEC_LISTEN} \
    --directory /var/lib/fennecdb/router/directory.fennec \
    --region ${FENNEC_REGION} \
    --global ${FENNEC_GLOBAL} \
    --replicas \
    --auto-failover ${FENNEC_LEASE} \
    --max-connections 1000 \
    --upstream-timeout ${FENNEC_UPSTREAM_TIMEOUT} \
    --audit /var/log/fennecdb/router/audit.log \
    $FENNEC_ROUTER_FLAGS
Restart=on-failure
RestartSec=2s

# The router writes and syncs each change of its directory before it acts
# on it, so SIGTERM's default action loses nothing: it holds no write. What
# it ends are the requests it was forwarding, which a client sends again.
KillSignal=SIGTERM
TimeoutStopSec=10s

# Descriptors: a client's connection each (--max-connections 1000) and a
# pooled one to a node for each in flight, the directory's replication and
# its standbys' streams, and the refused connections held open while their
# requests are read off (512 at most) -- 2 x 1000 + 512, with room. Raise
# with them.
LimitNOFILE=8192
# Threads: a connection each, under systemd's DefaultTasksMax unless set.
TasksMax=4096
# A core dump would hold every node's admin token.
LimitCORE=0

StateDirectory=fennecdb/router
StateDirectoryMode=0700
LogsDirectory=fennecdb/router
ReadWritePaths=/var/lib/fennecdb/router
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
