# /etc/fennecdb/archive.env -- every archiver on this machine
# (fennec-archive@<node>.service). Mode 0600, owned by root. The bucket sync
# reads archive-sync.env, never this file.

# The nodes' replication token (node.env's FENNEC_REPLICATION_TOKEN): an
# archive is the replication stream written to files.
FENNEC_REPLICATION_TOKEN=change-me-replication-token
