<Project Sdk="Microsoft.NET.Sdk">
  <!-- What `dotnet new console` writes on the Quickstart, with the FennecDb SDK
       as this checkout holds it in place of `dotnet add package FennecDb`.
       Run by ../../run-tests.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../dotnet/FennecDb/FennecDb.csproj" />
  </ItemGroup>
</Project>
